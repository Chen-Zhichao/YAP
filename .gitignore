# Python environments and generated caches.
__pycache__/
*.py[cod]
venv/
env/
build/
dist/
*.egg-info/

# Local settings stay private; repository policy and CI remain publishable.
.*
!.gitignore
!.gitattributes
!.github/
!.github/**
!**/.gitkeep
.env
.env.*
*.pem
*.key
\#snapshot/
.snapshot/

# Results at any depth, not just a root-level output directory.
/user_runs/
output/
paper_results/
temp/
*.log
*.out
*.nfs*
*.ipynb
show_profile.py
W2W/*profile*.txt

# Native mechanics and operators are shared separately, not uploaded to GitHub.
/runtime/
/ASSEMBLY_RUNTIME.json
*.npy
*.npz
*.joblib
*.h5
*.hdf5
*.rst
*.rth
*.emat
*.full
*.page

# Generated plots, tables and delivery archives.
*.png
*.pdf
*.csv
*.tar.zst
*.zip
*.tar.gz
*.tar
*.7z

# Legacy dense benchmarks and per-interface generated configs stay local.
design_*/
design_*.yaml
*.3dbv
*.3dbx
*.3dbf
*.bmap
cfg.yaml

